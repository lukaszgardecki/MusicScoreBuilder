<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>


<ContextMenu xmlns="http://javafx.com/javafx/21"
             xmlns:fx="http://javafx.com/fxml/1"
             fx:id="contextMenu"
             fx:controller="org.example.musicscorebuilder.controller.ContextMenuController"
             styleClass="score-context-menu">
    <items>
        <MenuItem fx:id="cutItem" text="Wy_tnij" accelerator="Shortcut+X" onAction="#handleCut">
            <graphic>
                <SVGPath content="M9.64 7.64c.23-.5.36-1.05.36-1.64 0-2.21-1.79-4-4-4S2 3.79 2 6s1.79 4 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1L9.64 7.64zM6 8c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm0 12c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm9.64-7.64L22 4V3h-3l-3.36 3.36 2 2z"
                         fill="#4a4a4a" scaleX="0.65" scaleY="0.65" styleClass="svg-path"/>
            </graphic>
        </MenuItem>
        <MenuItem fx:id="copyItem" text="_Kopiuj" accelerator="Shortcut+C" onAction="#handleCopy">
            <graphic>
                <SVGPath content="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                         fill="#4a4a4a" scaleX="0.65" scaleY="0.65" styleClass="svg-path"/>
            </graphic>
        </MenuItem>

        <MenuItem fx:id="pasteItem" text="Wk_lej" accelerator="Shortcut+V" onAction="#handlePaste">
            <graphic>
                <SVGPath content="M19 2h-4.18C14.4.84 13.3 0 12 0S9.6.84 9.18 2H5c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM5 20V4h2v3h10V4h2v16H5z"
                         fill="#4a4a4a" scaleX="0.65" scaleY="0.65" styleClass="svg-path"/>
            </graphic>
        </MenuItem>

        <SeparatorMenuItem fx:id="selectionSeparator" />

        <MenuItem fx:id="clearMeasuresItem" text="Wyczyść takty" accelerator="Delete" onAction="#handleClearMeasures">
            <graphic>
                <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                         fill="#4a4a4a" scaleX="0.65" scaleY="0.65" styleClass="svg-path"/>
            </graphic>
        </MenuItem>

        <MenuItem fx:id="deleteMeasuresItem" text="Usuń takty" accelerator="Shortcut+Delete" onAction="#handleDeleteMeasures">
            <graphic>
                <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                         fill="#4a4a4a" scaleX="0.65" scaleY="0.65" styleClass="svg-path"/>
            </graphic>
        </MenuItem>

        <SeparatorMenuItem fx:id="measureSeparator" />
        <MenuItem fx:id="staffPropertiesItem" text="Właściwości pięciolinii/partii..." onAction="#handleStaffProperties"/>


        <Menu fx:id="insertMeasuresMenu" text="Wstaw takty">
            <MenuItem text="Wstaw takt przed" onAction="#handleInsertMeasureBefore"/>
            <MenuItem text="Wstaw takt za" onAction="#handleInsertMeasureAfter"/>
            <MenuItem text="Wstaw wiele taktów..." onAction="#handleInsertMultipleMeasures"/>
        </Menu>


        <MenuItem fx:id="measurePropertiesItem" text="Właściwości taktu..." onAction="#handleMeasureProperties"/>
        <MenuItem fx:id="notePropertiesItem" text="Właściwości nuty..." onAction="#handleNoteProperties"/>
    </items>
</ContextMenu>