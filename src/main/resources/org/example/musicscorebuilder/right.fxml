<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane prefWidth="300.0"
         tabClosingPolicy="UNAVAILABLE"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="org.example.musicscorebuilder.controller.songbookcontroller.SongbookController">

    <Tab text="Śpiewnik">
        <VBox spacing="10" style="-fx-padding: 10;">
            <Button fx:id="openFolderButton"
                    text="Otwórz folder"
                    onAction="#handleOpenFolder"
                    styleClass="btn"
                    maxWidth="Infinity"/>

            <Label fx:id="folderPathLabel"
                   text="Nie wybrano folderu"
                   style="-fx-font-size: 11px; -fx-text-fill: #666666;"
                   wrapText="true"/>

            <Separator />

            <HBox spacing="8">
                <Button onAction="#handleAddFolder"
                        styleClass="btn, btn-folder"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS">
                    <tooltip>
                        <Tooltip text="Nowy folder" />
                    </tooltip>
                    <graphic>
                        <Region styleClass="icon, icon-folder-add" />
                    </graphic>
                </Button>
                <Button onAction="#handleAddFile"
                        styleClass="btn, btn-file"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS">
                    <tooltip>
                        <Tooltip text="Nowy plik" />
                    </tooltip>
                    <graphic>
                        <Region styleClass="icon, icon-file-add" />
                    </graphic>
                </Button>
                <Button fx:id="deleteButton"
                        onAction="#handleDelete"
                        styleClass="btn, btn-danger"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS">
                    <tooltip>
                        <Tooltip text="Usuń element" />
                    </tooltip>
                    <graphic>
                        <Region styleClass="icon, icon-trash" />
                    </graphic>
                </Button>
            </HBox>

            <Separator />

            <CheckBox fx:id="compressedOnlyCheckBox"
                      text="Pokaż skompresowane"
                      onAction="#handleFilterChange" />
            <Label text="Pliki śpiewnika:" style="-fx-font-weight: bold;" />
            <ListView fx:id="jsonFilesListView" VBox.vgrow="ALWAYS" />
        </VBox>
    </Tab>
</TabPane>