<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<ToolBar
    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="org.example.musicscorebuilder.controller.ToolbarController"
    styleClass="main-toolbar"
>
    <Separator />
    <Button fx:id="modeButton" styleClass="toolbar-btn" onAction="#toggleMode"/>
    <Separator />
    <Button fx:id="btn32" styleClass="toolbar-btn"/>
    <Button fx:id="btn16" styleClass="toolbar-btn"/>
    <Button fx:id="btn8" styleClass="toolbar-btn"/>
    <Button fx:id="btn4" styleClass="toolbar-btn"/>
    <Button fx:id="btn2" styleClass="toolbar-btn"/>
    <Button fx:id="btn1" styleClass="toolbar-btn"/>
    <Separator />
    <Button fx:id="btnDot" styleClass="toolbar-btn" onAction="#toggleDot"/>
    <Button fx:id="btnRest" styleClass="toolbar-btn" onAction="#createRest"/>
    <Separator />
    <Button fx:id="btnDoubleFlat" styleClass="toolbar-btn" onAction="#toggleDoubleFlat"/>
    <Button fx:id="btnFlat" styleClass="toolbar-btn" onAction="#toggleFlat"/>
    <Button fx:id="btnNatural" styleClass="toolbar-btn" onAction="#toggleNatural"/>
    <Button fx:id="btnSharp" styleClass="toolbar-btn" onAction="#toggleSharp"/>
    <Button fx:id="btnDoubleSharp" styleClass="toolbar-btn" onAction="#toggleDoubleSharp"/>
    <Separator />
    <Button fx:id="btnTie" styleClass="toolbar-btn" onAction="#addTie"/>
    <Button fx:id="btnSlur" styleClass="toolbar-btn" onAction="#addSlur"/>
    <Separator />
    <Button fx:id="voice1Button" styleClass="toolbar-btn" text="1" onAction="#activateVoice1"/>
    <Button fx:id="voice2Button" styleClass="toolbar-btn" text="2" onAction="#activateVoice2"/>
    <Button fx:id="voice3Button" styleClass="toolbar-btn" text="3" onAction="#activateVoice3"/>
    <Button fx:id="voice4Button" styleClass="toolbar-btn" text="4" onAction="#activateVoice4"/>
    <Separator />
    <Button fx:id="addMeasure" styleClass="toolbar-btn" text="+" onAction="#addMeasure"/>
    <Button fx:id="removeMeasure" styleClass="toolbar-btn" text="-" onAction="#removeMeasure"/>
</ToolBar>
